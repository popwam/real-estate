NODE_ENV=development
PORT=3000
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/popwam?schema=public"

# JWT placeholders for Team 1 auth.
JWT_SECRET="replace-me-access-secret"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="replace-me-refresh-secret"
JWT_REFRESH_EXPIRES_IN="30d"

# Private file storage. Attendance evidence must remain private.
FILE_STORAGE_PROVIDER=local
FILE_STORAGE_LOCAL_ROOT=
FILE_STORAGE_BUCKET=
FILE_STORAGE_REGION=
FILE_STORAGE_ENDPOINT=
FILE_STORAGE_ACCESS_KEY_ID=
FILE_STORAGE_SECRET_ACCESS_KEY=
FILE_STORAGE_PUBLIC_BASE_URL=
ATTENDANCE_PHOTO_FRESHNESS_MINUTES=10
ATTENDANCE_EVIDENCE_RETENTION_DAYS=
ATTENDANCE_EVIDENCE_CLEANUP_ENABLED=false
