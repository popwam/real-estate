NODE_ENV=development
PORT=3000
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/popwam?schema=public"

# API URLs
API_BASE_URL=http://localhost:3000
ADMIN_WEB_BASE_URL=http://localhost:3203
PUBLIC_WEB_BASE_URL=http://localhost:3205

# CORS: exact origins plus safe HTTPS suffixes. Never use "*".
CORS_ORIGINS=http://localhost:3203,http://127.0.0.1:3203,http://localhost:3205,http://127.0.0.1:3205
CORS_ALLOWED_SUFFIXES=popwam.com,staging.popwam.com

# JWT placeholders only. Use long random values in real deployments.
JWT_SECRET=replace-with-access-secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace-with-refresh-secret
JWT_REFRESH_EXPIRES_IN=30d

# Storage provider. Keep legacy FILE_STORAGE_* temporarily for migration compatibility.
FILE_STORAGE_PROVIDER=local
FILE_STORAGE_LOCAL_ROOT=
FILE_STORAGE_REGION=auto
FILE_STORAGE_ENDPOINT=

# R2 common config.
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_REGION=auto

# R2 public media bucket.
R2_PUBLIC_MEDIA_BUCKET=popwam-public-media-dev
R2_PUBLIC_MEDIA_ACCESS_KEY_ID=replace-with-public-media-key
R2_PUBLIC_MEDIA_SECRET_ACCESS_KEY=replace-with-public-media-secret

# R2 project media bucket.
R2_PROJECT_MEDIA_BUCKET=popwam-project-media-dev
R2_PROJECT_MEDIA_ACCESS_KEY_ID=replace-with-project-media-key
R2_PROJECT_MEDIA_SECRET_ACCESS_KEY=replace-with-project-media-secret

# R2 private company documents bucket.
R2_COMPANY_DOCUMENTS_BUCKET=popwam-company-documents-dev
R2_COMPANY_DOCUMENTS_ACCESS_KEY_ID=replace-with-company-documents-key
R2_COMPANY_DOCUMENTS_SECRET_ACCESS_KEY=replace-with-company-documents-secret

# R2 private chat attachments bucket.
R2_CHAT_ATTACHMENTS_BUCKET=popwam-chat-attachments-dev
R2_CHAT_ATTACHMENTS_ACCESS_KEY_ID=replace-with-chat-attachments-key
R2_CHAT_ATTACHMENTS_SECRET_ACCESS_KEY=replace-with-chat-attachments-secret

# R2 private HR/applicant documents bucket.
R2_HR_DOCUMENTS_BUCKET=popwam-hr-documents-dev
R2_HR_DOCUMENTS_ACCESS_KEY_ID=replace-with-hr-documents-key
R2_HR_DOCUMENTS_SECRET_ACCESS_KEY=replace-with-hr-documents-secret

# R2 private attendance evidence bucket.
R2_ATTENDANCE_EVIDENCE_BUCKET=popwam-attendance-evidence-dev
R2_ATTENDANCE_EVIDENCE_ACCESS_KEY_ID=replace-with-attendance-evidence-key
R2_ATTENDANCE_EVIDENCE_SECRET_ACCESS_KEY=replace-with-attendance-evidence-secret

# R2 private quarantine bucket for unknown/missing purpose uploads.
R2_QUARANTINE_UPLOADS_BUCKET=popwam-quarantine-uploads-dev
R2_QUARANTINE_UPLOADS_ACCESS_KEY_ID=replace-with-quarantine-key
R2_QUARANTINE_UPLOADS_SECRET_ACCESS_KEY=replace-with-quarantine-secret

# Cloudflare AI / document extraction. Manual review remains required.
CLOUDFLARE_ACCOUNT_ID=replace-with-account-id
CLOUDFLARE_API_TOKEN=replace-with-cloudflare-api-token
CLOUDFLARE_AI_GATEWAY_ID=replace-with-ai-gateway-id
CLOUDFLARE_AI_MODEL=@cf/meta/llama-3.1-8b-instruct
DOCUMENT_EXTRACTION_PROVIDER=NONE
DOCUMENT_EXTRACTION_AUTO_RUN=false
DOCUMENT_EXTRACTION_MAX_FILE_MB=10
DOCUMENT_EXTRACTION_DAILY_LIMIT_PER_ORG=25
DOCUMENT_EXTRACTION_MONTHLY_LIMIT_PER_ORG=250

# Public company site / domain defaults.
PUBLIC_ROOT_DOMAIN=popwam.com
PUBLIC_STAGING_ROOT_DOMAIN=staging.popwam.com
COMPANY_PUBLIC_SITE_FALLBACK_PATH=/sites
COMPANY_PORTAL_FALLBACK_BASE_URL=http://localhost:3205
ENABLE_WILDCARD_SUBDOMAINS=false
COMPANY_DEFAULT_DOMAIN_PATTERN={slug}.popwam.com
COMPANY_STAGING_DOMAIN_PATTERN={slug}.staging.popwam.com

# Attendance.
ATTENDANCE_PHOTO_MAX_BYTES=5242880
ATTENDANCE_PHOTO_FRESHNESS_MINUTES=10
ATTENDANCE_EVIDENCE_RETENTION_DAYS=
ATTENDANCE_EVIDENCE_CLEANUP_ENABLED=false
HR_IMAGE_MAX_BYTES=5242880
HR_APPLICANT_DOCUMENT_MAX_BYTES=10485760
ORGANIZATION_DOCUMENT_MAX_BYTES=10485760
