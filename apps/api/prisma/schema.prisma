model Organization {
  id                          String                           @id @default(cuid())
  name                        String
  slug                        String                           @unique
  companyCode                 String?                          @unique
  type                        OrganizationType
  country                     String?
  city                        String?
  timezone                    String?
  currency                    String?
  defaultLanguage             String?
  status                      OrganizationStatus               @default(DRAFT)
  plan                        String?
  planExpiresAt               DateTime?
  createdAt                   DateTime                         @default(now())
  updatedAt                   DateTime                         @updatedAt
  archivedAt                  DateTime?
  archivedPreviousStatus      OrganizationStatus?
  companySetupCompletedAt     DateTime?
  enabledLoginMethods         Json                             @default("[\"EMAIL_PASSWORD\",\"PHONE_PASSWORD\"]")
  profile                     OrganizationProfile?
  verifications               OrganizationVerification[]
  users                       User[]
  roles                       Role[]
  auditLogs                   AuditLog[]
  uploadedFiles               UploadedFile[]
  notificationEvents          NotificationEvent[]
  developerProfile            DeveloperProfile?
  brokerageProfile            BrokerageProfile?
  brokerProfiles              BrokerProfile[]
  projects                    Project[]                        @relation("DeveloperProjects")
  inventoryUnits              InventoryUnit[]                  @relation("DeveloperInventoryUnits")
  brokerAccessRules           BrokerAccessRule[]               @relation("DeveloperBrokerAccessRules")
  developerAgreements         DeveloperBrokerageAgreement[]    @relation("DeveloperAgreements")
  brokerageAgreements         DeveloperBrokerageAgreement[]    @relation("BrokerageAgreements")
  developerDealRooms          DealRoom[]                       @relation("DeveloperDealRooms")
  brokerageDealRooms          DealRoom[]                       @relation("BrokerageDealRooms")
  dealRoomParticipants        DealRoomParticipant[]
  developerDeals              Deal[]                           @relation("DeveloperDeals")
  brokerageDeals              Deal[]                           @relation("BrokerageDeals")
  commissionRules             CommissionRule[]                 @relation("DeveloperCommissionRules")
  recipientCommissionRules    CommissionRule[]                 @relation("CommissionRuleRecipientOrganization")
  developerCommissionEntries  CommissionEntry[]                @relation("DeveloperCommissionEntries")
  brokerageCommissionEntries  CommissionEntry[]                @relation("BrokerageCommissionEntries")
  recipientCommissionEntries  CommissionEntry[]                @relation("CommissionEntryRecipientOrganization")
  websiteSettings             OrganizationWebsiteSettings?
  publicSiteSettings          OrganizationPublicSiteSettings?
  owners                      OrganizationOwner[]
  organizationDocuments       OrganizationDocument[]
  domainVerifications         OrganizationDomainVerification[]
  publicLeads                 PublicLead[]
  crmClients                  CrmClient[]
  crmLeads                    CrmLead[]                        @relation("CrmLeadOwningOrganization")
  claimedCrmLeads             CrmLead[]                        @relation("CrmLeadClaimedOrganization")
  conversations               Conversation[]
  conversationParticipants    ConversationParticipant[]
  crmActivities               CrmActivity[]                    @relation("CrmActivityOrganization")
  actorCrmActivities          CrmActivity[]                    @relation("CrmActivityActorOrganization")
  importJobs                  ImportJob[]
  crmPipelineStages           CrmPipelineStage[]
  crmNotes                    CrmNote[]
  crmFollowUpTasks            CrmFollowUpTask[]
  hrDepartments               HrDepartment[]
  hrEmployees                 HrEmployee[]
  hrWorkGroups                HrWorkGroup[]
  hrTeams                     HrTeam[]
  hrEmployeeDocuments         HrEmployeeDocument[]
  hrJobOpenings               HrJobOpening[]
  hrApplicants                HrApplicant[]
  hrApplicantDocuments        HrApplicantDocument[]
  hrApplicantInterviews       HrApplicantInterview[]
  hrApplicantOffers           HrApplicantOffer[]
  hrRecruitmentSettings       HrRecruitmentSettings?
  hrEmployeeTransferLogs      HrEmployeeTransferLog[]
  hrEmployeeTitleChangeLogs   HrEmployeeTitleChangeLog[]
  hrAttendanceRecords         HrAttendanceRecord[]
  employeeAttendanceReferencePhotos EmployeeAttendanceReferencePhoto[]
  attendanceSettings          OrganizationAttendanceSettings?
  branches                    OrganizationBranch[]
  subscription                OrganizationSubscription?
  limits                      OrganizationLimits?
  companyRoleTemplates        CompanyRoleTemplate[]
  attendanceLocations         OrganizationAttendanceLocation[]
  wifiRules                   OrganizationWifiRule[]
  accountingAccounts          AccountingAccount[]
  accountingCategories        AccountingCategory[]
  accountingTransactions      AccountingTransaction[]
  legalDocuments              LegalDocument[]
  legalCases                  LegalCase[]
  adsCampaigns                AdsCampaign[]
  cameraDevices               CameraDevice[]
  operationsActivities        OperationsActivity[]
  invitations                 OrganizationInvitation[]
  projectBrokerAuthorizations ProjectBrokerAuthorization[]
  assignedPublicLeads         PublicLead[]                     @relation("PublicLeadAssignedOrganization")
  attributedVisitorSessions   PublicVisitorSession[]           @relation("VisitorAttributedOrganization")
  customerProfiles            CustomerProfile[]
  realEstateProjects          Compound[]
  buildings                   Building[]
  floors                      Floor[]
  units                       Unit[]
  unitCustomerAssignments     UnitCustomerAssignment[]
  unitQrPasses                UnitQrPass[]
  accessIntegrations          AccessIntegration[]
  supportedOrganizationTypeId String?
  supportedOrganizationType   SupportedOrganizationType?       @relation(fields: [supportedOrganizationTypeId], references: [id], onDelete: SetNull)
  completedOnboardingSession  OrganizationOnboardingSession?   @relation("CompletedOnboardingOrganization")

  @@index([type, status])
  @@index([supportedOrganizationTypeId])
  @@map("organizations")
}

model PlatformPlan {
  id                  String                   @id @default(cuid())
  code                String                   @unique
  name                String
  localizedName       Json?
  description         String?
  planType            PlatformPlanType         @default(PAID)
  priceAmount         Decimal?                 @db.Decimal(12, 2)
  priceCurrency       String                   @default("USD")
  billingCycle        OrganizationBillingCycle @default(MONTHLY)
  durationValue       Int                      @default(1)
  durationUnit        PlanDurationUnit         @default(MONTH)
  allowsNoExpiry      Boolean                  @default(false)
  trialDays           Int                      @default(0)
  limits              Json                     @default("{}")
  enabledModules      Json                     @default("{}")
  allowedLoginMethods Json                     @default("[\"EMAIL_PASSWORD\",\"PHONE_PASSWORD\"]")
  isActive            Boolean                  @default(true)
  isArchived          Boolean                  @default(false)
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt

  @@index([isActive, isArchived])
  @@map("platform_plans")
}

model RequiredDocumentPolicy {
  id                          String                           @id @default(cuid())
  countryCode                 String
  organizationType            OrganizationType?
  legalForm                   OrganizationLegalForm?
  documentType                OrganizationDocumentType
  isRequired                  Boolean                          @default(true)
  requiresExpiryDate          Boolean                          @default(false)
  ownerDocumentRequired       Boolean                          @default(false)
  appliesToOwnerRoles         Json                             @default("[]")
  isActive                    Boolean                          @default(true)
  notes                       String?
  supportedOrganizationTypeId String?
  requiredFieldCodes          String[]                         @default([])
  acceptedMimeTypes           String[]                         @default(["application/pdf", "image/jpeg", "image/png", "image/webp"])
  maxFileSizeMb               Int                              @default(10)
  minimumConfidence           Decimal?                         @db.Decimal(5, 4)
  blocksActivation            Boolean                          @default(true)
  sortOrder                   Int                              @default(0)
  isArchived                  Boolean                          @default(false)
  createdAt                   DateTime                         @default(now())
  updatedAt                   DateTime                         @updatedAt
  supportedOrganizationType   SupportedOrganizationType?       @relation(fields: [supportedOrganizationTypeId], references: [id], onDelete: SetNull)
  onboardingDocuments         OrganizationOnboardingDocument[]

  @@index([countryCode, organizationType, isActive])
  @@index([supportedOrganizationTypeId, countryCode, isActive, isArchived, sortOrder])
  @@map("required_document_policies")
}

model CompanyRoleTemplate {
  id             String       @id @default(cuid())
  organizationId String
  code           String
  displayName    String
  localizedName  Json?
  description    String?
  permissions    String[]     @default([])
  isSystem       Boolean      @default(false)
  isActive       Boolean      @default(true)
  sortOrder      Int          @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, code])
  @@index([organizationId, isActive, sortOrder])
  @@map("company_role_templates")
}

model OrganizationProfile {
  id                          String                 @id @default(cuid())
  organizationId              String                 @unique
  legalName                   String?
  tradeName                   String?
  displayName                 String?
  responsibleSubmitterName    String?
  responsibleSubmitterEmail   String?
  responsibleSubmitterPhone   String?
  commercialRegNumber         String?
  commercialRegisterNumber    String?
  commercialRegisterOffice    String?
  commercialRegisterIssuedAt  DateTime?
  commercialRegisterExpiresAt DateTime?
  registrationNumber          String?
  taxNumber                   String?
  vatNumber                   String?
  taxOffice                   String?
  legalForm                   OrganizationLegalForm?
  incorporationDate           DateTime?
  countryCode                 String?
  regionCode                  String?
  cityCode                    String?
  cityName                    String?
  addressLine1                String?
  addressLine2                String?
  postalCode                  String?
  preferredLanguage           String?
  defaultCurrency             String?
  publicEmail                 String?
  publicPhone                 String?
  website                     String?
  phone                       String?
  email                       String?
  address                     String?
  logoUrl                     String?
  description                 String?
  localizedDisplayName        Json?
  socialLinks                 Json?
  createdAt                   DateTime               @default(now())
  updatedAt                   DateTime               @updatedAt
  organization                Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("organization_profiles")
}

model OrganizationPublicSiteSettings {
  id                 String                      @id @default(cuid())
  organizationId     String                      @unique
  mode               OrganizationPublicSiteMode  @default(PORTAL)
  theme              OrganizationPublicSiteTheme @default(REAL_ESTATE)
  defaultLanguage    String                      @default("en")
  supportedLanguages String[]                    @default(["en", "ar", "fr"])
  showLogo           Boolean                     @default(true)
  showContactInfo    Boolean                     @default(true)
  showOffices        Boolean                     @default(true)
  showGallery        Boolean                     @default(true)
  showProjects       Boolean                     @default(true)
  showLeadForm       Boolean                     @default(true)
  redirectUrl        String?
  seoTitle           Json?
  seoDescription     Json?
  publicHeadline     Json?
  publicDescription  Json?
  galleryImages      Json?
  createdAt          DateTime                    @default(now())
  updatedAt          DateTime                    @updatedAt
  organization       Organization                @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([mode, theme])
  @@map("organization_public_site_settings")
}

model OrganizationOwner {
  id                     String                              @id @default(cuid())
  organizationId         String
  ownerType              OrganizationOwnerType               @default(PERSON)
  name                   String
  localizedName          Json?
  nationalityCountryCode String?
  identifierType         OrganizationOwnerIdentifierType?
  identifierValue        String?
  identifierCountryCode  String?
  ownershipPercentage    Decimal?                            @db.Decimal(5, 2)
  role                   OrganizationOwnerRole               @default(OWNER)
  phone                  String?
  email                  String?
  idFrontFileId          String?
  idBackFileId           String?
  passportFileId         String?
  proofFileId            String?
  verificationStatus     OrganizationOwnerVerificationStatus @default(NOT_REVIEWED)
  createdAt              DateTime                            @default(now())
  updatedAt              DateTime                            @updatedAt
  organization           Organization                        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  idFrontFile            UploadedFile?                       @relation("OrganizationOwnerIdFrontFile", fields: [idFrontFileId], references: [id], onDelete: SetNull)
  idBackFile             UploadedFile?                       @relation("OrganizationOwnerIdBackFile", fields: [idBackFileId], references: [id], onDelete: SetNull)
  passportFile           UploadedFile?                       @relation("OrganizationOwnerPassportFile", fields: [passportFileId], references: [id], onDelete: SetNull)
  proofFile              UploadedFile?                       @relation("OrganizationOwnerProofFile", fields: [proofFileId], references: [id], onDelete: SetNull)

  @@index([organizationId, verificationStatus])
  @@map("organization_owners")
}

model OrganizationDocument {
  id                 String                               @id @default(cuid())
  organizationId     String
  documentType       OrganizationDocumentType
  fileId             String?
  status             OrganizationDocumentStatus           @default(MISSING)
  expiresAt          DateTime?
  issuedAt           DateTime?
  issuingAuthority   String?
  extractedData      Json?
  extractionProvider DocumentExtractionProvider           @default(NONE)
  extractionStatus   OrganizationDocumentExtractionStatus @default(NOT_REQUESTED)
  extractionMessage  String?
  reviewedById       String?
  reviewedAt         DateTime?
  createdAt          DateTime                             @default(now())
  updatedAt          DateTime                             @updatedAt
  organization       Organization                         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  file               UploadedFile?                        @relation("OrganizationDocumentFile", fields: [fileId], references: [id], onDelete: SetNull)
  reviewedBy         User?                                @relation("OrganizationDocumentReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([organizationId, documentType, status])
  @@index([organizationId, extractionStatus])
  @@map("organization_documents")
}

model OrganizationVerification {
  id              String             @id @default(cuid())
  organizationId  String
  documentType    String
  uploadedFileId  String?
  documentUrl     String?
  expiryDate      DateTime?
  status          VerificationStatus @default(DRAFT)
  verifiedById    String?
  verifiedAt      DateTime?
  rejectionReason String?
  notes           String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  organization    Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  uploadedFile    UploadedFile?      @relation(fields: [uploadedFileId], references: [id], onDelete: SetNull)
  verifiedBy      User?              @relation("VerifiedOrganizationDocuments", fields: [verifiedById], references: [id], onDelete: SetNull)

  @@index([organizationId, status])
  @@map("organization_verifications")
}

model OrganizationWebsiteSettings {
  id              String       @id @default(cuid())
  organizationId  String       @unique
  publicSlug      String       @unique
  subdomain       String       @unique
  customDomain    String?      @unique
  siteTitle       String
  siteDescription String?
  logoUrl         String?
  primaryColor    String?
  secondaryColor  String?
  contactPhone    String?
  contactEmail    String?
  whatsappUrl     String?
  isPublished     Boolean      @default(false)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([isPublished])
  @@map("organization_website_settings")
}

model OrganizationDomainVerification {
  id                String                        @id @default(cuid())
  organizationId    String
  domain            String
  type              OrganizationDomainType
  status            DomainVerificationStatus      @default(PENDING)
  verificationToken String
  isDefault         Boolean                       @default(false)
  lastCheckedAt     DateTime?
  verifiedAt        DateTime?
  failureReason     String?
  statusNote        String?
  redirectMode      OrganizationRedirectMode      @default(NONE)
  redirectUrl       String?
  inboundSourceMode OrganizationInboundSourceMode @default(NONE)
  createdAt         DateTime                      @default(now())
  updatedAt         DateTime                      @updatedAt
  organization      Organization                  @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, domain])
  @@index([domain, type, status])
  @@map("organization_domain_verifications")
}

model OrganizationSubscription {
  id                    String                         @id @default(cuid())
  organizationId        String                         @unique
  planCode              String
  planName              String
  status                OrganizationSubscriptionStatus @default(TRIAL)
  startsAt              DateTime?
  endsAt                DateTime?
  trialEndsAt           DateTime?
  billingCycle          OrganizationBillingCycle       @default(MONTHLY)
  autoRenew             Boolean                        @default(false)
  notes                 String?
  endDateOverridden     Boolean                        @default(false)
  endDateOverrideReason String?
  createdAt             DateTime                       @default(now())
  updatedAt             DateTime                       @updatedAt
  organization          Organization                   @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([status, endsAt])
  @@map("organization_subscriptions")
}

model OrganizationLimits {
  id                    String       @id @default(cuid())
  organizationId        String       @unique
  maxEmployees          Int          @default(25)
  maxOffices            Int          @default(1)
  maxBranches           Int          @default(1)
  maxWorkGroups         Int          @default(5)
  maxTeams              Int          @default(10)
  maxStorageMb          Int          @default(1024)
  maxMonthlyCheckIns    Int          @default(1000)
  enabledModules        Json         @default("{}")
  allowWebCheckIn       Boolean      @default(true)
  allowMobileCheckIn    Boolean      @default(true)
  allowPublicWebsite    Boolean      @default(true)
  allowCustomDomain     Boolean      @default(false)
  allowSubdomain        Boolean      @default(true)
  allowDvrReview        Boolean      @default(false)
  allowFaceVerification Boolean      @default(false)
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt
  organization          Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("organization_limits")
}

model User {
  id                                 String                          @id @default(cuid())
  organizationId                     String?
  roleId                             String?
  email                              String                          @unique
  passwordHash                       String?
  mustChangePassword                 Boolean                         @default(false)
  firstName                          String?
  lastName                           String?
  phone                              String?
  userRole                           UserRole
  isActive                           Boolean                         @default(true)
  lastLoginAt                        DateTime?
  createdAt                          DateTime                        @default(now())
  updatedAt                          DateTime                        @updatedAt
  organization                       Organization?                   @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  role                               Role?                           @relation(fields: [roleId], references: [id], onDelete: SetNull)
  refreshTokens                      RefreshToken[]
  auditLogs                          AuditLog[]
  uploadedFiles                      UploadedFile[]
  notificationEvents                 NotificationEvent[]
  verifiedOrganizationDocuments      OrganizationVerification[]      @relation("VerifiedOrganizationDocuments")
  brokerProfile                      BrokerProfile?
  verifiedBrokerProfiles             BrokerProfile[]                 @relation("VerifiedBrokerProfiles")
  unitHolds                          UnitAvailability[]              @relation("UnitHolds")
  grantedBrokerAccessRules           BrokerAccessRule[]              @relation("BrokerAccessGrantedBy")
  createdClients                     Client[]                        @relation("ClientCreatedBy")
  leads                              Lead[]                          @relation("LeadBroker")
  leadClaims                         LeadClaim[]                     @relation("LeadClaimBroker")
  leadClaimConflicts                 LeadClaimConflict[]             @relation("LeadClaimConflictAttemptedBy")
  resolvedLeadClaimConflicts         LeadClaimConflict[]             @relation("LeadClaimConflictResolvedBy")
  reservationRequests                ReservationRequest[]            @relation("ReservationRequestBroker")
  createdDealRooms                   DealRoom[]                      @relation("DealRoomCreatedBy")
  brokerDealRooms                    DealRoom[]                      @relation("DealRoomBroker")
  dealRoomParticipants               DealRoomParticipant[]
  dealRoomMessages                   DealRoomMessage[]               @relation("DealRoomMessageSenderUser")
  createdDeals                       Deal[]                          @relation("DealCreatedBy")
  approvedDeals                      Deal[]                          @relation("DealApprovedBy")
  cancelledDeals                     Deal[]                          @relation("DealCancelledBy")
  brokerDeals                        Deal[]                          @relation("DealBroker")
  targetCommissionRules              CommissionRule[]                @relation("CommissionRuleTargetUser")
  brokerCommissionEntries            CommissionEntry[]               @relation("CommissionEntryBroker")
  recipientCommissionEntries         CommissionEntry[]               @relation("CommissionEntryRecipientUser")
  createdImportJobs                  ImportJob[]                     @relation("ImportJobCreatedBy")
  claimedCrmLeads                    CrmLead[]                       @relation("CrmLeadClaimedBroker")
  conversationParticipants           ConversationParticipant[]
  crmActivities                      CrmActivity[]                   @relation("CrmActivityActorUser")
  crmLeadStageChanges                CrmLeadStageHistory[]           @relation("CrmLeadStageChangedBy")
  authoredCrmNotes                   CrmNote[]                       @relation("CrmNoteAuthor")
  assignedCrmTasks                   CrmFollowUpTask[]               @relation("CrmTaskAssignee")
  createdCrmTasks                    CrmFollowUpTask[]               @relation("CrmTaskCreator")
  hrEmployeeProfile                  HrEmployee?
  managedHrEmployees                 HrEmployee[]                    @relation("HrEmployeeDirectManager")
  secondaryManagedHrEmployees        HrEmployee[]                    @relation("HrEmployeeSecondaryManager")
  managedHrWorkGroups                HrWorkGroupManager[]
  managedHrTeams                     HrTeam[]                        @relation("HrTeamManager")
  createdHrJobOpenings               HrJobOpening[]                  @relation("HrJobOpeningCreatedBy")
  reviewedHrApplicants               HrApplicant[]                   @relation("HrApplicantReviewedBy")
  interviewedHrApplicants            HrApplicantInterview[]          @relation("HrApplicantInterviewer")
  createdHrEmployeeTransferLogs      HrEmployeeTransferLog[]         @relation("HrTransferLogCreatedBy")
  createdHrEmployeeTitleChanges      HrEmployeeTitleChangeLog[]      @relation("HrTitleChangeCreatedBy")
  createdAccountingTransactions      AccountingTransaction[]         @relation("AccountingTransactionCreatedBy")
  operationsActivities               OperationsActivity[]            @relation("OperationsActivityActorUser")
  approvedAccountingTransactions     AccountingTransaction[]         @relation("AccountingTransactionApprovedBy")
  reviewedLegalDocuments             LegalDocument[]                 @relation("LegalDocumentReviewedBy")
  reviewedOrganizationDocuments      OrganizationDocument[]          @relation("OrganizationDocumentReviewedBy")
  createdOrganizationInvitations     OrganizationInvitation[]        @relation("InvitationCreatedBy")
  acceptedOrganizationInvitations    OrganizationInvitation[]        @relation("InvitationAcceptedBy")
  createdProjectBrokerAuthorizations ProjectBrokerAuthorization[]    @relation("ProjectBrokerAuthorizationCreatedBy")
  brokerProjectAuthorizations        ProjectBrokerAuthorization[]    @relation("ProjectBrokerAuthorizationBroker")
  assignedPublicLeads                PublicLead[]                    @relation("PublicLeadAssignedBroker")
  attributedVisitorSessions          PublicVisitorSession[]          @relation("VisitorAttributedBroker")
  customerProfiles                   CustomerProfile[]
  unitCustomerAssignments            UnitCustomerAssignment[]
  unitQrPasses                       UnitQrPass[]
  navigationPreferences              UserNavigationPreference[]
  quickActionPreferences             UserQuickActionPreference[]
  createdOnboardingSessions          OrganizationOnboardingSession[] @relation("OnboardingCreatedBy")
  reviewedFieldEvidence              OrganizationFieldEvidence[]     @relation("FieldEvidenceReviewedBy")
  approvedAttendanceReferencePhotos  EmployeeAttendanceReferencePhoto[] @relation("AttendanceReferenceApprovedBy")
  revokedAttendanceReferencePhotos   EmployeeAttendanceReferencePhoto[] @relation("AttendanceReferenceRevokedBy")
  reviewedAttendanceFaceVerifications HrAttendanceRecord[] @relation("AttendanceFaceVerificationReviewedBy")

  @@index([organizationId, userRole])
  @@map("users")
}

model Role {
  id             String           @id @default(cuid())
  organizationId String?
  name           String
  description    String?
  isSystem       Boolean          @default(false)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  organization   Organization?    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  users          User[]
  permissions    RolePermission[]

  @@unique([organizationId, name])
  @@map("roles")
}

model Permission {
  id          String           @id @default(cuid())
  key         String           @unique
  description String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  roles       RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String
  createdAt    DateTime   @default(now())
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("refresh_tokens")
}

model AuditLog {
  id             String        @id @default(cuid())
  organizationId String?
  actorUserId    String?
  action         String
  entityType     String
  entityId       String?
  metadata       Json?
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime      @default(now())
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  actorUser      User?         @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, entityType, entityId])
  @@index([actorUserId, createdAt])
  @@map("audit_logs")
}

model UploadedFile {
  id                             String                           @id @default(cuid())
  organizationId                 String?
  uploadedById                   String?
  filePurpose                    FilePurpose                      @default(QUARANTINE)
  bucket                         String
  objectKey                      String
  url                            String?
  mimeType                       String?
  sizeBytes                      Int?
  visibility                     FileVisibility                   @default(PRIVATE)
  checksum                       String?
  createdAt                      DateTime                         @default(now())
  organization                   Organization?                    @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  uploadedBy                     User?                            @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  organizationVerifications      OrganizationVerification[]
  organizationDocuments          OrganizationDocument[]           @relation("OrganizationDocumentFile")
  organizationOwnerIdFrontFiles  OrganizationOwner[]              @relation("OrganizationOwnerIdFrontFile")
  organizationOwnerIdBackFiles   OrganizationOwner[]              @relation("OrganizationOwnerIdBackFile")
  organizationOwnerPassportFiles OrganizationOwner[]              @relation("OrganizationOwnerPassportFile")
  organizationOwnerProofFiles    OrganizationOwner[]              @relation("OrganizationOwnerProofFile")
  hrApplicantDocuments           HrApplicantDocument[]            @relation("HrApplicantDocumentFile")
  onboardingDocuments            OrganizationOnboardingDocument[]
  attendanceReferencePhotoFiles  EmployeeAttendanceReferencePhoto[] @relation("AttendanceReferencePhotoFile")
  attendanceReferenceImages      HrAttendanceRecord[] @relation("AttendanceRecordReferenceImage")
  attendanceCapturedImages       HrAttendanceRecord[] @relation("AttendanceRecordCapturedImage")

  @@index([organizationId, createdAt])
  @@map("uploaded_files")
}

model NotificationEvent {
  id             String        @id @default(cuid())
  organizationId String?
  userId         String?
  type           String
  channel        String
  payload        Json
  status         String        @default("PENDING")
  scheduledAt    DateTime?
  sentAt         DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  user           User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId, status])
  @@index([type, createdAt])
  @@map("notification_events")
}

model DeveloperProfile {
  id                  String       @id @default(cuid())
  organizationId      String       @unique
  yearsInMarket       Int?
  totalUnitsDelivered Int?
  portfolioUrl        String?
  reraRegistration    String?
  nucaRegistration    String?
  activeProjectsCount Int          @default(0)
  settings            Json?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  organization        Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("developer_profiles")
}

model BrokerageProfile {
  id                  String       @id @default(cuid())
  organizationId      String       @unique
  brokerLicenseNumber String?
  reraBrokerageNumber String?
  maxBrokersAllowed   Int?
  activeBrokersCount  Int          @default(0)
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  organization        Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("brokerage_profiles")
}

model BrokerProfile {
  id                 String             @id @default(cuid())
  userId             String             @unique
  organizationId     String?
  isIndividual       Boolean            @default(false)
  nationalId         String?
  nationalIdUrl      String?
  yearsExperience    Int?
  specializations    String[]
  verificationStatus VerificationStatus @default(DRAFT)
  verifiedById       String?
  restrictionLevel   String?
  dealCount          Int                @default(0)
  successRate        Float?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization       Organization?      @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  verifiedBy         User?              @relation("VerifiedBrokerProfiles", fields: [verifiedById], references: [id], onDelete: SetNull)

  @@index([organizationId, verificationStatus])
  @@map("broker_profiles")
}

model Project {
  id                   String                       @id @default(cuid())
  developerId          String
  name                 String
  slug                 String
  type                 ProjectType
  status               ProjectStatus                @default(DRAFT)
  city                 String?
  district             String?
  // TODO(Team 2): replace latitude/longitude with PostGIS geometry once Prisma mapping is finalized.
  latitude             Decimal?                     @db.Decimal(10, 7)
  longitude            Decimal?                     @db.Decimal(10, 7)
  address              String?
  deliveryDate         DateTime?
  description          String?
  coverImageUrl        String?
  images               String[]
  videos               String[]
  brochureUrl          String?
  amenities            String[]
  visibility           ProjectVisibility            @default(PRIVATE)
  sellingMode          ProjectSellingMode           @default(OWNER_ONLY)
  isFeatured           Boolean                      @default(false)
  createdAt            DateTime                     @default(now())
  updatedAt            DateTime                     @updatedAt
  developer            Organization                 @relation("DeveloperProjects", fields: [developerId], references: [id], onDelete: Cascade)
  phases               ProjectPhase[]
  inventoryUnits       InventoryUnit[]
  paymentPlans         PaymentPlan[]
  brokerAccessRules    BrokerAccessRule[]
  clients              Client[]
  leads                Lead[]
  leadClaims           LeadClaim[]
  leadClaimConflicts   LeadClaimConflict[]
  reservationRequests  ReservationRequest[]
  dealRooms            DealRoom[]
  deals                Deal[]
  commissionRules      CommissionRule[]
  commissionEntries    CommissionEntry[]
  publicLeads          PublicLead[]
  crmLeads             CrmLead[]
  conversations        Conversation[]
  legalDocuments       LegalDocument[]
  cameraDevices        CameraDevice[]
  brokerAuthorizations ProjectBrokerAuthorization[]
  visitorSessions      PublicVisitorSession[]
  visitorEvents        PublicVisitorEvent[]

  @@unique([developerId, slug])
  @@index([developerId, status])
  @@index([city, district])
  @@map("projects")
}

model OrganizationInvitation {
  id               String           @id @default(cuid())
  organizationId   String
  email            String
  intendedRole     UserRole
  tokenHash        String           @unique
  status           InvitationStatus @default(PENDING)
  expiresAt        DateTime
  acceptedAt       DateTime?
  createdByUserId  String
  acceptedByUserId String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  organization     Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy        User             @relation("InvitationCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  acceptedBy       User?            @relation("InvitationAcceptedBy", fields: [acceptedByUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, status])
  @@index([email, status])
  @@index([expiresAt, status])
  @@map("organization_invitations")
}

model ProjectBrokerAuthorization {
  id              String                           @id @default(cuid())
  projectId       String
  organizationId  String?
  brokerUserId    String?
  status          ProjectBrokerAuthorizationStatus @default(ACTIVE)
  createdByUserId String
  createdAt       DateTime                         @default(now())
  updatedAt       DateTime                         @updatedAt
  project         Project                          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  organization    Organization?                    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  brokerUser      User?                            @relation("ProjectBrokerAuthorizationBroker", fields: [brokerUserId], references: [id], onDelete: Cascade)
  createdBy       User                             @relation("ProjectBrokerAuthorizationCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@unique([projectId, organizationId])
  @@unique([projectId, brokerUserId])
  @@index([projectId, status])
  @@index([organizationId, status])
  @@index([brokerUserId, status])
  @@map("project_broker_authorizations")
}

model ProjectPhase {
  id             String          @id @default(cuid())
  projectId      String
  name           String
  deliveryDate   DateTime?
  totalUnits     Int?
  availableUnits Int?
  status         ProjectStatus   @default(DRAFT)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  project        Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  inventoryUnits InventoryUnit[]

  @@index([projectId, status])
  @@map("project_phases")
}

model InventoryUnit {
  id                  String               @id @default(cuid())
  projectId           String
  phaseId             String?
  developerId         String
  unitNumber          String
  unitType            UnitType
  floor               String?
  areaSqm             Decimal?             @db.Decimal(12, 2)
  bedrooms            Int?
  bathrooms           Int?
  finishing           UnitFinishing?
  view                String?
  basePrice           Decimal?             @db.Decimal(14, 2)
  currency            String               @default("EGP")
  pricePerSqm         Decimal?             @db.Decimal(14, 2)
  status              UnitStatus           @default(AVAILABLE)
  visibility          UnitVisibility       @default(INHERIT_PROJECT)
  images              String[]
  floorPlanUrl        String?
  features            Json?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  project             Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  phase               ProjectPhase?        @relation(fields: [phaseId], references: [id], onDelete: SetNull)
  developer           Organization         @relation("DeveloperInventoryUnits", fields: [developerId], references: [id], onDelete: Cascade)
  availabilityRecords UnitAvailability[]
  paymentPlans        PaymentPlan[]
  leads               Lead[]
  leadClaims          LeadClaim[]
  reservationRequests ReservationRequest[]
  dealRooms           DealRoom[]
  deals               Deal[]
  commissionEntries   CommissionEntry[]
  crmLeads            CrmLead[]
  conversations       Conversation[]

  @@unique([projectId, unitNumber])
  @@index([developerId, status])
  @@index([projectId, status])
  @@map("inventory_units")
}

model UnitAvailability {
  id                   String               @id @default(cuid())
  unitId               String
  heldById             String?
  reservationRequestId String?
  heldType             AvailabilityHoldType
  heldAt               DateTime             @default(now())
  expiresAt            DateTime?
  releasedAt           DateTime?
