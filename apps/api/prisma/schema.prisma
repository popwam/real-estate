  @@index([dealRoomId, createdAt])
  @@index([senderUserId, createdAt])
  @@index([senderClientId, createdAt])
  @@map("deal_room_messages")
}

model Deal {
  id              String        @id @default(cuid())
  dealRoomId      String        @unique
  projectId       String
  unitId          String
  developerId     String
  brokerageId     String?
  brokerUserId    String
  leadId          String
  leadClaimId     String
  clientId        String
  status          DealStatus    @default(SOLD)
  finalPrice      Decimal?      @db.Decimal(14, 2)
  currency        String        @default("EGP")
  createdByUserId String
  approvedById    String?
  approvedAt      DateTime?
  soldAt          DateTime?
  cancelledById   String?
  cancelledAt     DateTime?
  cancellationReason String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  dealRoom        DealRoom      @relation(fields: [dealRoomId], references: [id], onDelete: Cascade)
  project         Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  unit            InventoryUnit @relation(fields: [unitId], references: [id], onDelete: Cascade)
  developer       Organization  @relation("DeveloperDeals", fields: [developerId], references: [id], onDelete: Cascade)
  brokerage       Organization? @relation("BrokerageDeals", fields: [brokerageId], references: [id], onDelete: SetNull)
  broker          User          @relation("DealBroker", fields: [brokerUserId], references: [id], onDelete: Cascade)
  lead            Lead          @relation(fields: [leadId], references: [id], onDelete: Cascade)
  leadClaim       LeadClaim     @relation(fields: [leadClaimId], references: [id], onDelete: Cascade)
  client          Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  createdBy       User          @relation("DealCreatedBy", fields: [createdByUserId], references: [id], onDelete: Cascade)
  approvedBy      User?         @relation("DealApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  cancelledBy     User?         @relation("DealCancelledBy", fields: [cancelledById], references: [id], onDelete: SetNull)
  commissionEntries CommissionEntry[]
  disputes        CommissionDispute[]

  @@index([developerId, status])
  @@index([brokerUserId, status])
  @@index([brokerageId, status])
  @@index([projectId, unitId])
  @@map("deals")
}

model CommissionRule {
  id              String              @id @default(cuid())
  developerId     String
  projectId       String
  partyType       CommissionPartyType
  targetOrganizationId String?
  targetUserId    String?
  commissionType  CommissionType
  value           Decimal             @db.Decimal(14, 4)
  currency        String              @default("EGP")
  isActive        Boolean             @default(true)
  notes           String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  developer       Organization        @relation("DeveloperCommissionRules", fields: [developerId], references: [id], onDelete: Cascade)
  project         Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  targetOrganization Organization?    @relation("CommissionRuleRecipientOrganization", fields: [targetOrganizationId], references: [id], onDelete: SetNull)
  targetUser      User?               @relation("CommissionRuleTargetUser", fields: [targetUserId], references: [id], onDelete: SetNull)
  commissionEntries CommissionEntry[]

  @@index([developerId, projectId, isActive])
  @@index([partyType, targetOrganizationId])
  @@index([partyType, targetUserId])
  @@map("commission_rules")
}

model CommissionEntry {
  id              String              @id @default(cuid())
  dealId          String
  commissionRuleId String?
  projectId       String
  unitId          String
  developerId     String
  brokerageId     String?
  brokerUserId    String
  partyType       CommissionPartyType
  recipientOrganizationId String?
  recipientUserId String?
  commissionType  CommissionType?
  amount          Decimal             @db.Decimal(14, 2)
  currency        String              @default("EGP")
  status          CommissionStatus    @default(PENDING)
  rejectionReason String?
  approvedAt      DateTime?
  rejectedAt      DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  deal            Deal                @relation(fields: [dealId], references: [id], onDelete: Cascade)
  commissionRule  CommissionRule?     @relation(fields: [commissionRuleId], references: [id], onDelete: SetNull)
  project         Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  unit            InventoryUnit       @relation(fields: [unitId], references: [id], onDelete: Cascade)
  developer       Organization        @relation("DeveloperCommissionEntries", fields: [developerId], references: [id], onDelete: Cascade)
  brokerage       Organization?       @relation("BrokerageCommissionEntries", fields: [brokerageId], references: [id], onDelete: SetNull)
  broker          User                @relation("CommissionEntryBroker", fields: [brokerUserId], references: [id], onDelete: Cascade)
  recipientOrganization Organization? @relation("CommissionEntryRecipientOrganization", fields: [recipientOrganizationId], references: [id], onDelete: SetNull)
  recipientUser   User?               @relation("CommissionEntryRecipientUser", fields: [recipientUserId], references: [id], onDelete: SetNull)
  disputes        CommissionDispute[]

  @@index([developerId, status])
  @@index([brokerageId, status])
  @@index([brokerUserId, status])
  @@index([recipientOrganizationId, status])
  @@index([recipientUserId, status])
  @@map("commission_entries")
}

model CommissionDispute {
  id              String        @id @default(cuid())
  dealId          String
  commissionEntryId String?
  status          DisputeStatus @default(OPEN)
  reason          String?
  resolutionNotes String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  deal            Deal          @relation(fields: [dealId], references: [id], onDelete: Cascade)
  commissionEntry CommissionEntry? @relation(fields: [commissionEntryId], references: [id], onDelete: SetNull)

  @@index([dealId, status])
  @@index([commissionEntryId, status])
  @@map("commission_disputes")
}

model PublicLead {
