  updatedAt             DateTime                  @updatedAt
  lead                  Lead                      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  leadClaim             LeadClaim                 @relation(fields: [leadClaimId], references: [id], onDelete: Cascade)
