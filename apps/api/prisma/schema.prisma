  @@map("crm_clients")
}

model CrmLead {
  id                        String                  @id @default(cuid())
  organizationId            String
  projectId                 String?
  unitId                    String?
  publicLeadId              String?                 @unique
  clientId                  String
  status                    CrmLeadStatus           @default(NEW)
  statusNote                String?
  pipelineStageId           String?
  preferredContactMethod    PreferredContactMethod  @default(CALL)
  claimedByBrokerUserId     String?
  claimedByOrganizationId   String?
  claimedAt                 DateTime?
  assignmentType            LeadAssignmentType?
  assignmentReason          String?
  sourcePage                String?
  utm                       Json?
  createdAt                 DateTime                @default(now())
  updatedAt                 DateTime                @updatedAt
  organization              Organization            @relation("CrmLeadOwningOrganization", fields: [organizationId], references: [id], onDelete: Cascade)
  project                   Project?                @relation(fields: [projectId], references: [id], onDelete: SetNull)
  unit                      InventoryUnit?          @relation(fields: [unitId], references: [id], onDelete: SetNull)
  publicLead                PublicLead?             @relation(fields: [publicLeadId], references: [id], onDelete: SetNull)
  client                    CrmClient               @relation(fields: [clientId], references: [id], onDelete: Cascade)
  claimedByBroker           User?                   @relation("CrmLeadClaimedBroker", fields: [claimedByBrokerUserId], references: [id], onDelete: SetNull)
  claimedByOrganization     Organization?           @relation("CrmLeadClaimedOrganization", fields: [claimedByOrganizationId], references: [id], onDelete: SetNull)
  pipelineStage             CrmPipelineStage?       @relation(fields: [pipelineStageId], references: [id], onDelete: SetNull)
  stageHistory              CrmLeadStageHistory[]
  conversations             Conversation[]
  activities                CrmActivity[]
  notes                     CrmNote[]
  followUpTasks             CrmFollowUpTask[]

  @@index([organizationId, status])
  @@index([organizationId, pipelineStageId])
  @@index([projectId, status])
  @@index([claimedByBrokerUserId, status])
  @@index([claimedByOrganizationId, status])
  @@index([clientId])
  @@map("crm_leads")
}

model Conversation {
  id              String                    @id @default(cuid())
  organizationId  String
  projectId       String?
  unitId          String?
  crmLeadId       String?
  type            ConversationType          @default(PUBLIC_LEAD)
  status          ConversationStatus        @default(OPEN)
  statusNote      String?
  shareToken      String                    @unique
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt
  organization    Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project         Project?                  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  unit            InventoryUnit?            @relation(fields: [unitId], references: [id], onDelete: SetNull)
  crmLead         CrmLead?                  @relation(fields: [crmLeadId], references: [id], onDelete: SetNull)
  participants    ConversationParticipant[]
  messages        ConversationMessage[]
  activities      CrmActivity[]
  notes           CrmNote[]

  @@index([organizationId, status])
  @@index([projectId, status])
  @@index([crmLeadId, status])
  @@map("conversations")
}

model ConversationParticipant {
  id              String                      @id @default(cuid())
  conversationId  String
  userId          String?
  organizationId  String?
  publicRole      ConversationParticipantRole
  displayName     String?
  joinedAt        DateTime                    @default(now())
  lastReadAt      DateTime?
  conversation    Conversation                @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user            User?                       @relation(fields: [userId], references: [id], onDelete: SetNull)
  organization    Organization?               @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  messages        ConversationMessage[]

  @@index([conversationId, publicRole])
  @@index([userId, conversationId])
  @@index([organizationId, conversationId])
  @@map("conversation_participants")
}

model ConversationMessage {
  id                    String                    @id @default(cuid())
  conversationId         String
  senderParticipantId    String?
  type                  ConversationMessageType    @default(TEXT)
  body                  String
  metadata              Json?
  createdAt             DateTime                  @default(now())
  conversation          Conversation              @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderParticipant     ConversationParticipant?  @relation(fields: [senderParticipantId], references: [id], onDelete: SetNull)

  @@index([conversationId, createdAt])
  @@index([senderParticipantId, createdAt])
  @@map("conversation_messages")
}

model CrmActivity {
  id                    String           @id @default(cuid())
  organizationId        String
  crmLeadId             String?
  conversationId        String?
  actorUserId           String?
  actorOrganizationId   String?
  actorRole             String?
  publicActorName       String?
  type                  CrmActivityType
  title                 String
  body                  String?
  metadata              Json?
  createdAt             DateTime         @default(now())
  organization          Organization     @relation("CrmActivityOrganization", fields: [organizationId], references: [id], onDelete: Cascade)
  crmLead               CrmLead?         @relation(fields: [crmLeadId], references: [id], onDelete: SetNull)
  conversation          Conversation?    @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  actorUser             User?            @relation("CrmActivityActorUser", fields: [actorUserId], references: [id], onDelete: SetNull)
  actorOrganization     Organization?    @relation("CrmActivityActorOrganization", fields: [actorOrganizationId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([crmLeadId, createdAt])
  @@index([conversationId, createdAt])
  @@index([type, createdAt])
  @@map("crm_activities")
}

model CrmPipelineStage {
  id             String                @id @default(cuid())
  organizationId String
  name           String
  key            String
  order          Int
  color          String?
  isDefault      Boolean               @default(false)
  isActive       Boolean               @default(true)
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  organization   Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  leads          CrmLead[]
  fromHistory    CrmLeadStageHistory[] @relation("CrmLeadStageFrom")
  toHistory      CrmLeadStageHistory[] @relation("CrmLeadStageTo")

  @@unique([organizationId, key])
  @@index([organizationId, isActive, order])
  @@map("crm_pipeline_stages")
}

model CrmLeadStageHistory {
  id              String            @id @default(cuid())
  crmLeadId       String
  fromStageId     String?
  toStageId       String
  changedByUserId String?
  note            String?
  createdAt       DateTime          @default(now())
  crmLead         CrmLead           @relation(fields: [crmLeadId], references: [id], onDelete: Cascade)
  fromStage       CrmPipelineStage? @relation("CrmLeadStageFrom", fields: [fromStageId], references: [id], onDelete: SetNull)
  toStage         CrmPipelineStage  @relation("CrmLeadStageTo", fields: [toStageId], references: [id], onDelete: Cascade)
  changedBy       User?             @relation("CrmLeadStageChangedBy", fields: [changedByUserId], references: [id], onDelete: SetNull)

  @@index([crmLeadId, createdAt])
  @@index([toStageId, createdAt])
  @@map("crm_lead_stage_history")
}

model CrmNote {
  id              String            @id @default(cuid())
  organizationId  String
  crmLeadId       String?
  conversationId  String?
  authorUserId    String
  body            String
  visibility      CrmNoteVisibility @default(INTERNAL)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  organization    Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  crmLead         CrmLead?          @relation(fields: [crmLeadId], references: [id], onDelete: SetNull)
  conversation    Conversation?     @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  author          User              @relation("CrmNoteAuthor", fields: [authorUserId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@index([crmLeadId, createdAt])
  @@index([conversationId, createdAt])
  @@map("crm_notes")
}

model CrmFollowUpTask {
  id               String                  @id @default(cuid())
  organizationId   String
  crmLeadId        String?
  assignedToUserId String?
  title            String
  dueAt            DateTime?
  status           CrmFollowUpTaskStatus   @default(OPEN)
  priority         CrmFollowUpTaskPriority @default(NORMAL)
  createdByUserId  String
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  organization     Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  crmLead          CrmLead?                @relation(fields: [crmLeadId], references: [id], onDelete: SetNull)
  assignedTo       User?                   @relation("CrmTaskAssignee", fields: [assignedToUserId], references: [id], onDelete: SetNull)
  createdBy        User                    @relation("CrmTaskCreator", fields: [createdByUserId], references: [id], onDelete: Cascade)

  @@index([organizationId, status, dueAt])
  @@index([crmLeadId, status])
  @@index([assignedToUserId, status])
  @@map("crm_follow_up_tasks")
}

model ImportJob {
  id                String             @id @default(cuid())
  organizationId    String
  createdByUserId   String?
  type              ImportJobType      @default(PROJECT_INVENTORY)
  status            ImportJobStatus    @default(DRAFT)
  originalFileName  String?
  sourceFormat      ImportSourceFormat
  totalRows         Int                @default(0)
  validRows         Int                @default(0)
  invalidRows       Int                @default(0)
  summary           Json?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  committedAt       DateTime?
  organization      Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy         User?              @relation("ImportJobCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  rows              ImportJobRow[]

  @@index([organizationId, status, createdAt])
  @@index([createdByUserId, createdAt])
  @@map("import_jobs")
}

model ImportJobRow {
  id                String          @id @default(cuid())
  importJobId       String
  rowNumber         Int
  rawData           Json
  normalizedData    Json?
  status            ImportRowStatus
  errors            Json?
  warnings          Json?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  importJob         ImportJob       @relation(fields: [importJobId], references: [id], onDelete: Cascade)

  @@unique([importJobId, rowNumber])
  @@index([importJobId, status])
  @@map("import_job_rows")
}

model HrDepartment {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employees      HrEmployee[]

  @@index([organizationId, isActive])
  @@map("hr_departments")
}

model HrEmployee {
  id             String               @id @default(cuid())
  organizationId String
  userId         String?              @unique
  departmentId   String?
  name           String
  email          String?
  phone          String?
  roleTitle      String?
  status         HrEmployeeStatus     @default(ACTIVE)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  department     HrDepartment?        @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  attendance     HrAttendanceRecord[]

  @@index([organizationId, status])
  @@index([departmentId, status])
  @@map("hr_employees")
}

model HrAttendanceRecord {
  id             String             @id @default(cuid())
  organizationId String
  employeeId     String
  date           DateTime
  checkInAt      DateTime?
  checkOutAt     DateTime?
  status         HrAttendanceStatus
  note           String?
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employee       HrEmployee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([organizationId, date])
  @@index([employeeId, date])
  @@map("hr_attendance_records")
}

model AccountingAccount {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  code           String?
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, isActive])
  @@map("accounting_accounts")
}

model AccountingCategory {
  id             String                  @id @default(cuid())
  organizationId String
  name           String
  type           AccountingTransactionType?
  isActive       Boolean                 @default(true)
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  organization   Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  transactions   AccountingTransaction[]

  @@index([organizationId, isActive])
  @@map("accounting_categories")
}

model AccountingTransaction {
  id              String                    @id @default(cuid())
  organizationId  String
  type            AccountingTransactionType
  amount          Decimal                   @db.Decimal(14, 2)
  currency        String                    @default("EGP")
  categoryId      String?
  description     String?
  occurredAt      DateTime
  status          AccountingTransactionStatus @default(DRAFT)
  approvedByUserId String?
  approvedAt      DateTime?
  approvalNote    String?
  createdByUserId String?
  createdAt       DateTime                  @default(now())
  organization    Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category        AccountingCategory?       @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  createdBy       User?                     @relation("AccountingTransactionCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  approvedBy      User?                     @relation("AccountingTransactionApprovedBy", fields: [approvedByUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, occurredAt])
  @@index([organizationId, type])
  @@index([organizationId, status])
  @@map("accounting_transactions")
}

model LegalDocument {
  id               String              @id @default(cuid())
  organizationId   String
  title            String
  type             LegalDocumentType
  status           LegalDocumentStatus @default(DRAFT)
  relatedProjectId String?
  storageUrl       String?
  reviewedByUserId String?
  reviewedAt       DateTime?
  reviewNote       String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  organization     Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  relatedProject   Project?            @relation(fields: [relatedProjectId], references: [id], onDelete: SetNull)
  reviewedBy       User?               @relation("LegalDocumentReviewedBy", fields: [reviewedByUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, status])
  @@index([relatedProjectId])
  @@map("legal_documents")
}

model LegalCase {
  id             String          @id @default(cuid())
  organizationId String
  title          String
  status         LegalCaseStatus @default(OPEN)
  description    String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, status])
  @@map("legal_cases")
}

model AdsCampaign {
  id                 String              @id @default(cuid())
  organizationId     String
  name               String
  provider           AdsCampaignProvider
  status             AdsCampaignStatus   @default(DRAFT)
  budgetAmount       Decimal?            @db.Decimal(14, 2)
  currency           String?
  externalAccountId  String?
  externalCampaignId String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, status])
  @@map("ads_campaigns")
}

model CameraDevice {
  id              String               @id @default(cuid())
  organizationId  String
  projectId       String?
  name            String
  location        String?
  provider        CameraDeviceProvider
  streamUrlMasked String?
  status          CameraDeviceStatus   @default(ACTIVE)
  aiEnabled       Boolean              @default(false)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  organization    Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project         Project?             @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([organizationId, status])
  @@index([projectId, status])
  @@map("camera_devices")
}

model OperationsActivity {
  id             String           @id @default(cuid())
  organizationId String
  module         OperationsModule
  entityType     String
  entityId       String?
  actorUserId    String?
  action         String
  title          String
  body           String?
  metadata       Json?
  createdAt      DateTime         @default(now())
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actorUser      User?            @relation("OperationsActivityActorUser", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, module, createdAt])
  @@index([module, entityType, entityId, createdAt])
  @@index([actorUserId, createdAt])
  @@map("operations_activities")
}
