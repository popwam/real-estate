  leadClaimId           String
  leadId                String
  clientId              String
  projectId             String
  unitId                String
  developerId           String
  brokerageId           String?
  brokerUserId          String
  createdByUserId       String
  status                DealRoomStatus        @default(OPEN)
  clientInviteToken     String?
  clientInvitedAt       DateTime?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  reservationRequest    ReservationRequest    @relation(fields: [reservationRequestId], references: [id], onDelete: Cascade)
  leadClaim             LeadClaim             @relation(fields: [leadClaimId], references: [id], onDelete: Cascade)
  lead                  Lead                  @relation(fields: [leadId], references: [id], onDelete: Cascade)
  client                Client                @relation(fields: [clientId], references: [id], onDelete: Cascade)
  project               Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  unit                  InventoryUnit         @relation(fields: [unitId], references: [id], onDelete: Cascade)
  developer             Organization          @relation("DeveloperDealRooms", fields: [developerId], references: [id], onDelete: Cascade)
  brokerage             Organization?         @relation("BrokerageDealRooms", fields: [brokerageId], references: [id], onDelete: SetNull)
  broker                User                  @relation("DealRoomBroker", fields: [brokerUserId], references: [id], onDelete: Cascade)
  createdBy             User                  @relation("DealRoomCreatedBy", fields: [createdByUserId], references: [id], onDelete: Cascade)
  participants          DealRoomParticipant[]
  messages              DealRoomMessage[]
  deal                  Deal?

  @@index([developerId, status])
  @@index([brokerUserId, status])
  @@index([brokerageId, status])
  @@index([projectId, unitId])
  @@map("deal_rooms")
}

model DealRoomParticipant {
  id              String                    @id @default(cuid())
  dealRoomId      String
