generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum OrganizationType {
  PLATFORM
  DEVELOPER
  BROKERAGE
  INDIVIDUAL_BROKER
}

enum OrganizationStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  SUSPENDED
  REVOKED
}

enum VerificationStatus {
  DRAFT
  PENDING_REVIEW
  UNDER_REVIEW
  APPROVED
  REJECTED
  SUSPENDED
  REVOKED
  PENDING_RENEWAL
  EXPIRED
}

enum ProjectStatus {
  DRAFT
  ACTIVE
  SOLD_OUT
  SUSPENDED
  ARCHIVED
}

enum ProjectVisibility {
  PRIVATE
  APPROVED_BROKERAGES
  OPEN_MARKETPLACE
  SELECTED_BROKERS
  HIDDEN
}

enum ProjectSellingMode {
  OWNER_ONLY
  AUTHORIZED_BROKERS
  OPEN_BROKERAGE
}

enum ProjectBrokerAuthorizationStatus {
  ACTIVE
  SUSPENDED
  REVOKED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

enum LeadAssignmentType {
  COMPANY
  BROKER
  BROKERAGE
}

enum VisitorAttributionType {
  UNKNOWN
  COMPANY
  BROKER
  BROKERAGE
}

enum PublicVisitorEventType {
  PAGE_VIEW
  PROJECT_VIEW
  SEARCH
  FILTER_CHANGE
  SECTION_REACHED
  SCROLL_DEPTH
  TIME_ON_PAGE
  LEAD_SUBMITTED
  START_CHAT_CLICKED
  REQUEST_CALL_CLICKED
