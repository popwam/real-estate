  @@map("project_phases")
}

model InventoryUnit {
  id                    String              @id @default(cuid())
  projectId             String
  phaseId               String?
  developerId           String
  unitNumber            String
  unitType              UnitType
  floor                 String?
  areaSqm               Decimal?            @db.Decimal(12, 2)
