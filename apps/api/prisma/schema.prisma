  RESERVED
  SOLD
  HELD
  UNAVAILABLE
}

enum UnitType {
  APARTMENT
  VILLA
  TOWNHOUSE
  OFFICE
  SHOP
  STUDIO
  LAND
  CHALET
}

enum UnitVisibility {
  INHERIT_PROJECT
  PRIVATE
  APPROVED_BROKERAGES
  OPEN_MARKETPLACE
  SELECTED_BROKERS
  HIDDEN
