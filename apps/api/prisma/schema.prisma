  ACTIVE
  SUSPENDED
  TERMINATED
}

enum LeadStatus {
  NEW
  CONTACTED
  INTERESTED
  RESERVATION
  WON
  LOST
}

enum LeadClaimStatus {
  ACTIVE
  EXPIRED
  RELEASED
  DISPUTED
  WON
}

enum LeadClaimConflictResolution {
  FIRST_WINS
  ESCALATED
  MANUAL_REVIEW
}

enum ReservationRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum LeadSource {
  MANUAL
  META
  TIKTOK
  GOOGLE
  REFERRAL
}

enum DealRoomStatus {
  OPEN
  NEGOTIATION
  PENDING_APPROVAL
  APPROVED
  SOLD
  CANCELLED
  DISPUTED
}

enum DealRoomParticipantRole {
  BROKER
  DEVELOPER_SALES
  SALES_MANAGER
  CLIENT
  PLATFORM_SUPPORT
}

enum DealRoomParticipantStatus {
  INVITED
  ACTIVE
  LEFT
  REMOVED
}

enum DealRoomMessageType {
  TEXT
  SYSTEM
  DOCUMENT
  STATUS_UPDATE
}

enum DealStatus {
  PENDING_APPROVAL
  APPROVED
  SOLD
