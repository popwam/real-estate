  dealRooms             DealRoom[]
  deals                 Deal[]

  @@index([clientPhoneHash, projectId, status])
  @@index([brokerUserId, status])
  @@index([brokerageId, status])
  @@map("lead_claims")
}

model LeadClaimConflict {
  id                    String                        @id @default(cuid())
  existingClaimId       String
  attemptedById         String
  projectId             String
  clientPhoneHash       String
  resolution            LeadClaimConflictResolution?
  resolvedById          String?
  resolvedAt            DateTime?
  notes                 String?
  createdAt             DateTime                      @default(now())
  updatedAt             DateTime                      @updatedAt
  existingClaim         LeadClaim                     @relation("ExistingLeadClaimConflicts", fields: [existingClaimId], references: [id], onDelete: Cascade)
  attemptedBy           User                          @relation("LeadClaimConflictAttemptedBy", fields: [attemptedById], references: [id], onDelete: Cascade)
  project               Project                       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  resolvedBy            User?                         @relation("LeadClaimConflictResolvedBy", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([projectId, clientPhoneHash])
  @@index([attemptedById, createdAt])
  @@map("lead_claim_conflicts")
}

model ReservationRequest {
  id                    String                    @id @default(cuid())
  leadId                String
  leadClaimId           String
