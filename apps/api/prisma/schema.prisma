  DISPUTED
}

enum CommissionStatus {
  PENDING
  APPROVED
  REJECTED
  PAID
  CANCELLED
}

enum CommissionType {
  PERCENTAGE
  FIXED
}

enum CommissionPartyType {
  DEVELOPER
  BROKERAGE
  BROKER
  PLATFORM
}

enum DisputeStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  REJECTED
}

enum OrganizationDomainType {
  SUBDOMAIN
  CUSTOM_DOMAIN
}

enum DomainVerificationStatus {
  PENDING
  VERIFIED
  FAILED
}

enum PublicLeadStatus {
  NEW
  REVIEWED
  CONVERTED
  SPAM
}

enum CrmLeadStatus {
  NEW
  CLAIMED
  IN_CONVERSATION
  QUALIFIED
  LOST
  CONVERTED
  SPAM
}

enum PreferredContactMethod {
  CALL
  CHAT
  WHATSAPP
}

enum ConversationType {
  PUBLIC_LEAD
  DEAL_ROOM
  SUPPORT
}

enum ConversationStatus {
  OPEN
  CLOSED
  ARCHIVED
}

enum ConversationParticipantRole {
  CLIENT
  BROKER
  DEVELOPER
  PLATFORM
  SYSTEM
}

enum ConversationMessageType {
  TEXT
  SYSTEM
  CONTACT_REQUEST
  STATUS_UPDATE
}

enum CrmActivityType {
  LEAD_CREATED
  LEAD_CONVERTED
  LEAD_CLAIMED
  LEAD_STATUS_CHANGED
  LEAD_STAGE_CHANGED
  CONVERSATION_CREATED
  CONVERSATION_STATUS_CHANGED
  MESSAGE_SENT
  PUBLIC_MESSAGE_SENT
  NOTE_ADDED
  TASK_CREATED
  TASK_COMPLETED
}

enum CrmNoteVisibility {
  INTERNAL
}

enum CrmFollowUpTaskStatus {
  OPEN
  DONE
  CANCELLED
}

enum CrmFollowUpTaskPriority {
  LOW
  NORMAL
  HIGH
}

enum HrEmployeeStatus {
  ACTIVE
  INACTIVE
}

enum HrAttendanceStatus {
  PRESENT
  ABSENT
  LATE
  OFF
}

enum AccountingTransactionType {
  INCOME
  EXPENSE
}

enum AccountingTransactionStatus {
  DRAFT
  APPROVED
  REJECTED
}

enum LegalDocumentType {
  CONTRACT
  LICENSE
  AGREEMENT
  OTHER
}

enum LegalDocumentStatus {
  DRAFT
  ACTIVE
  EXPIRED
  ARCHIVED
}

enum LegalCaseStatus {
  OPEN
  CLOSED
  ON_HOLD
}

enum AdsCampaignProvider {
  GOOGLE
  META
  TIKTOK
  OTHER
}

enum AdsCampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
  ARCHIVED
}

enum CameraDeviceProvider {
  HIKVISION
  DAHUA
  GENERIC
  OTHER
}

enum CameraDeviceStatus {
  ACTIVE
  INACTIVE
}

enum OperationsModule {
  HR
  ACCOUNTING
  LEGAL
  ADS
  CAMERAS
}

enum ImportJobType {
  PROJECT_INVENTORY
  HR_EMPLOYEES
  HR_ATTENDANCE
  ACCOUNTING_TRANSACTIONS
  LEGAL_DOCUMENTS
  LEGAL_CASES
  ADS_CAMPAIGNS
  CAMERA_DEVICES
}

enum ImportJobStatus {
  DRAFT
  VALIDATING
  READY
  COMMITTED
  FAILED
  CANCELLED
}

enum ImportSourceFormat {
  CSV
  JSON
  XLSX
}

enum ImportRowStatus {
  VALID
  INVALID
  SKIPPED
  COMMITTED
}

enum UserRole {
  PLATFORM_OWNER
  PLATFORM_ADMIN
  PLATFORM_SUPPORT
  PLATFORM_AUDITOR
  DEVELOPER_OWNER
  DEVELOPER_ADMIN
  DEVELOPER_SALES_MANAGER
  DEVELOPER_SALES_AGENT
  BROKERAGE_OWNER
  BROKERAGE_ADMIN
  BROKER
  INDIVIDUAL_BROKER
  CLIENT
}

model Organization {
  id                  String                       @id @default(cuid())
  name                String
  slug                String                       @unique
  type                OrganizationType
  country             String?
  city                String?
  status              OrganizationStatus           @default(DRAFT)
  plan                String?
  planExpiresAt       DateTime?
  createdAt           DateTime                     @default(now())
  updatedAt           DateTime                     @updatedAt
  profile             OrganizationProfile?
  verifications       OrganizationVerification[]
  users               User[]
  roles               Role[]
  auditLogs           AuditLog[]
  uploadedFiles       UploadedFile[]
  notificationEvents  NotificationEvent[]
  developerProfile    DeveloperProfile?
  brokerageProfile    BrokerageProfile?
  brokerProfiles      BrokerProfile[]
  projects            Project[]                    @relation("DeveloperProjects")
  inventoryUnits      InventoryUnit[]              @relation("DeveloperInventoryUnits")
  brokerAccessRules   BrokerAccessRule[]           @relation("DeveloperBrokerAccessRules")
  developerAgreements DeveloperBrokerageAgreement[] @relation("DeveloperAgreements")
  brokerageAgreements DeveloperBrokerageAgreement[] @relation("BrokerageAgreements")
  developerDealRooms  DealRoom[]                    @relation("DeveloperDealRooms")
  brokerageDealRooms  DealRoom[]                    @relation("BrokerageDealRooms")
  dealRoomParticipants DealRoomParticipant[]
  developerDeals      Deal[]                        @relation("DeveloperDeals")
  brokerageDeals      Deal[]                        @relation("BrokerageDeals")
  commissionRules     CommissionRule[]              @relation("DeveloperCommissionRules")
  recipientCommissionRules CommissionRule[]          @relation("CommissionRuleRecipientOrganization")
  developerCommissionEntries CommissionEntry[]       @relation("DeveloperCommissionEntries")
  brokerageCommissionEntries CommissionEntry[]       @relation("BrokerageCommissionEntries")
  recipientCommissionEntries CommissionEntry[]       @relation("CommissionEntryRecipientOrganization")
  websiteSettings   OrganizationWebsiteSettings?
  domainVerifications OrganizationDomainVerification[]
  publicLeads       PublicLead[]
  crmClients        CrmClient[]
  crmLeads          CrmLead[]                    @relation("CrmLeadOwningOrganization")
  claimedCrmLeads   CrmLead[]                    @relation("CrmLeadClaimedOrganization")
  conversations     Conversation[]
  conversationParticipants ConversationParticipant[]
  crmActivities     CrmActivity[]                @relation("CrmActivityOrganization")
  actorCrmActivities CrmActivity[]               @relation("CrmActivityActorOrganization")
  importJobs        ImportJob[]
  crmPipelineStages CrmPipelineStage[]
  crmNotes          CrmNote[]
  crmFollowUpTasks  CrmFollowUpTask[]
  hrDepartments     HrDepartment[]
  hrEmployees       HrEmployee[]
  hrAttendanceRecords HrAttendanceRecord[]
  accountingAccounts AccountingAccount[]
  accountingCategories AccountingCategory[]
  accountingTransactions AccountingTransaction[]
  legalDocuments   LegalDocument[]
  legalCases       LegalCase[]
  adsCampaigns     AdsCampaign[]
  cameraDevices    CameraDevice[]
  operationsActivities OperationsActivity[]
  invitations       OrganizationInvitation[]
  projectBrokerAuthorizations ProjectBrokerAuthorization[]
  assignedPublicLeads PublicLead[]            @relation("PublicLeadAssignedOrganization")
  attributedVisitorSessions PublicVisitorSession[] @relation("VisitorAttributedOrganization")

  @@index([type, status])
  @@map("organizations")
}

model OrganizationProfile {
  id                      String        @id @default(cuid())
  organizationId          String        @unique
  legalName               String?
  tradeName               String?
  commercialRegNumber     String?
  taxNumber               String?
  website                 String?
  phone                   String?
  email                   String?
  address                 String?
  logoUrl                 String?
  description             String?
  socialLinks             Json?
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt
  organization            Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("organization_profiles")
}

model OrganizationVerification {
  id                  String              @id @default(cuid())
  organizationId      String
  documentType        String
  uploadedFileId      String?
  documentUrl         String?
  expiryDate          DateTime?
  status              VerificationStatus  @default(DRAFT)
  verifiedById        String?
  verifiedAt          DateTime?
  rejectionReason     String?
  notes               String?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  organization        Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  uploadedFile        UploadedFile?       @relation(fields: [uploadedFileId], references: [id], onDelete: SetNull)
  verifiedBy          User?               @relation("VerifiedOrganizationDocuments", fields: [verifiedById], references: [id], onDelete: SetNull)

  @@index([organizationId, status])
  @@map("organization_verifications")
}

model OrganizationWebsiteSettings {
  id              String        @id @default(cuid())
  organizationId  String        @unique
  publicSlug      String        @unique
  subdomain       String        @unique
  customDomain    String?       @unique
  siteTitle       String
  siteDescription String?
  logoUrl         String?
  primaryColor    String?
  secondaryColor  String?
  contactPhone    String?
  contactEmail    String?
  whatsappUrl     String?
  isPublished     Boolean       @default(false)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  organization    Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([isPublished])
  @@map("organization_website_settings")
}

model OrganizationDomainVerification {
  id                String                    @id @default(cuid())
  organizationId    String
  domain            String
  type              OrganizationDomainType
  status            DomainVerificationStatus  @default(PENDING)
  verificationToken String
  lastCheckedAt     DateTime?
  verifiedAt        DateTime?
  failureReason     String?
  statusNote        String?
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt
  organization      Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, domain])
  @@index([domain, type, status])
  @@map("organization_domain_verifications")
}

model User {
  id                              String                      @id @default(cuid())
  organizationId                  String?
  roleId                          String?
  email                           String                      @unique
  passwordHash                    String?
  firstName                       String?
  lastName                        String?
  phone                           String?
  userRole                        UserRole
  isActive                        Boolean                     @default(true)
  lastLoginAt                     DateTime?
  createdAt                       DateTime                    @default(now())
  updatedAt                       DateTime                    @updatedAt
  organization                    Organization?               @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  role                            Role?                       @relation(fields: [roleId], references: [id], onDelete: SetNull)
  refreshTokens                   RefreshToken[]
  auditLogs                       AuditLog[]
  uploadedFiles                   UploadedFile[]
  notificationEvents              NotificationEvent[]
  verifiedOrganizationDocuments   OrganizationVerification[]   @relation("VerifiedOrganizationDocuments")
  brokerProfile                   BrokerProfile?
  verifiedBrokerProfiles          BrokerProfile[]              @relation("VerifiedBrokerProfiles")
  unitHolds                       UnitAvailability[]           @relation("UnitHolds")
  grantedBrokerAccessRules        BrokerAccessRule[]           @relation("BrokerAccessGrantedBy")
  createdClients                  Client[]                      @relation("ClientCreatedBy")
  leads                           Lead[]                        @relation("LeadBroker")
  leadClaims                      LeadClaim[]                   @relation("LeadClaimBroker")
  leadClaimConflicts              LeadClaimConflict[]           @relation("LeadClaimConflictAttemptedBy")
  resolvedLeadClaimConflicts      LeadClaimConflict[]           @relation("LeadClaimConflictResolvedBy")
  reservationRequests             ReservationRequest[]          @relation("ReservationRequestBroker")
  createdDealRooms                DealRoom[]                    @relation("DealRoomCreatedBy")
  brokerDealRooms                 DealRoom[]                    @relation("DealRoomBroker")
  dealRoomParticipants            DealRoomParticipant[]
  dealRoomMessages                DealRoomMessage[]             @relation("DealRoomMessageSenderUser")
  createdDeals                    Deal[]                        @relation("DealCreatedBy")
  approvedDeals                   Deal[]                        @relation("DealApprovedBy")
  cancelledDeals                  Deal[]                        @relation("DealCancelledBy")
  brokerDeals                     Deal[]                        @relation("DealBroker")
  targetCommissionRules           CommissionRule[]              @relation("CommissionRuleTargetUser")
  brokerCommissionEntries         CommissionEntry[]             @relation("CommissionEntryBroker")
  recipientCommissionEntries      CommissionEntry[]             @relation("CommissionEntryRecipientUser")
  createdImportJobs                ImportJob[]                   @relation("ImportJobCreatedBy")
  claimedCrmLeads                 CrmLead[]                      @relation("CrmLeadClaimedBroker")
  conversationParticipants        ConversationParticipant[]
  crmActivities                   CrmActivity[]                   @relation("CrmActivityActorUser")
  crmLeadStageChanges             CrmLeadStageHistory[]           @relation("CrmLeadStageChangedBy")
  authoredCrmNotes                CrmNote[]                       @relation("CrmNoteAuthor")
  assignedCrmTasks                CrmFollowUpTask[]               @relation("CrmTaskAssignee")
  createdCrmTasks                 CrmFollowUpTask[]               @relation("CrmTaskCreator")
  hrEmployeeProfile               HrEmployee?
  createdAccountingTransactions   AccountingTransaction[]          @relation("AccountingTransactionCreatedBy")
  operationsActivities            OperationsActivity[]             @relation("OperationsActivityActorUser")
  approvedAccountingTransactions  AccountingTransaction[]          @relation("AccountingTransactionApprovedBy")
  reviewedLegalDocuments          LegalDocument[]                  @relation("LegalDocumentReviewedBy")
  createdOrganizationInvitations  OrganizationInvitation[]         @relation("InvitationCreatedBy")
  acceptedOrganizationInvitations OrganizationInvitation[]         @relation("InvitationAcceptedBy")
  createdProjectBrokerAuthorizations ProjectBrokerAuthorization[]  @relation("ProjectBrokerAuthorizationCreatedBy")
  brokerProjectAuthorizations     ProjectBrokerAuthorization[]      @relation("ProjectBrokerAuthorizationBroker")
  assignedPublicLeads             PublicLead[]                      @relation("PublicLeadAssignedBroker")
  attributedVisitorSessions       PublicVisitorSession[]            @relation("VisitorAttributedBroker")

  @@index([organizationId, userRole])
  @@map("users")
}

model Role {
  id              String            @id @default(cuid())
  organizationId  String?
  name            String
  description     String?
  isSystem        Boolean           @default(false)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  organization    Organization?     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  users           User[]
  permissions     RolePermission[]

  @@unique([organizationId, name])
  @@map("roles")
}

model Permission {
  id              String            @id @default(cuid())
  key             String            @unique
  description     String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  roles           RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId          String
  permissionId    String
  createdAt       DateTime      @default(now())
  role            Role          @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission      Permission    @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model RefreshToken {
  id              String      @id @default(cuid())
  userId          String
  tokenHash       String      @unique
  expiresAt       DateTime
  revokedAt       DateTime?
  createdAt       DateTime    @default(now())
  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("refresh_tokens")
}

model AuditLog {
  id              String          @id @default(cuid())
  organizationId  String?
  actorUserId     String?
  action          String
  entityType      String
  entityId        String?
  metadata        Json?
  ipAddress       String?
  userAgent       String?
  createdAt       DateTime        @default(now())
  organization    Organization?   @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  actorUser       User?           @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, entityType, entityId])
  @@index([actorUserId, createdAt])
  @@map("audit_logs")
}

model UploadedFile {
  id                          String                       @id @default(cuid())
  organizationId              String?
  uploadedById                String?
  bucket                      String
  objectKey                   String
  url                         String?
  mimeType                    String?
  sizeBytes                   Int?
  checksum                    String?
  createdAt                   DateTime                     @default(now())
  organization                Organization?                @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  uploadedBy                  User?                        @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  organizationVerifications   OrganizationVerification[]

  @@index([organizationId, createdAt])
  @@map("uploaded_files")
}

model NotificationEvent {
  id              String          @id @default(cuid())
  organizationId  String?
  userId          String?
  type            String
  channel         String
  payload         Json
  status          String          @default("PENDING")
  scheduledAt     DateTime?
  sentAt          DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  organization    Organization?   @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  user            User?           @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId, status])
  @@index([type, createdAt])
  @@map("notification_events")
}

model DeveloperProfile {
  id                    String        @id @default(cuid())
  organizationId        String        @unique
  yearsInMarket         Int?
  totalUnitsDelivered   Int?
  portfolioUrl          String?
  reraRegistration      String?
  nucaRegistration      String?
  activeProjectsCount   Int           @default(0)
  settings              Json?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  organization          Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("developer_profiles")
}

model BrokerageProfile {
  id                    String        @id @default(cuid())
  organizationId        String        @unique
  brokerLicenseNumber   String?
  reraBrokerageNumber   String?
  maxBrokersAllowed     Int?
  activeBrokersCount    Int           @default(0)
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  organization          Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("brokerage_profiles")
}

model BrokerProfile {
  id                    String              @id @default(cuid())
  userId                String              @unique
  organizationId        String?
  isIndividual          Boolean             @default(false)
  nationalId            String?
  nationalIdUrl         String?
  yearsExperience       Int?
  specializations       String[]
  verificationStatus    VerificationStatus  @default(DRAFT)
  verifiedById          String?
  restrictionLevel      String?
  dealCount             Int                 @default(0)
  successRate           Float?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  user                  User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization          Organization?       @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  verifiedBy            User?               @relation("VerifiedBrokerProfiles", fields: [verifiedById], references: [id], onDelete: SetNull)

  @@index([organizationId, verificationStatus])
  @@map("broker_profiles")
}

model Project {
  id                    String              @id @default(cuid())
  developerId           String
  name                  String
  slug                  String
  type                  ProjectType
  status                ProjectStatus       @default(DRAFT)
  city                  String?
  district              String?
  // TODO(Team 2): replace latitude/longitude with PostGIS geometry once Prisma mapping is finalized.
  latitude              Decimal?            @db.Decimal(10, 7)
  longitude             Decimal?            @db.Decimal(10, 7)
  address               String?
  deliveryDate          DateTime?
  description           String?
  coverImageUrl         String?
  images                String[]
  videos                String[]
  brochureUrl           String?
  amenities             String[]
  visibility            ProjectVisibility   @default(PRIVATE)
  sellingMode           ProjectSellingMode  @default(OWNER_ONLY)
  isFeatured            Boolean             @default(false)
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  developer             Organization        @relation("DeveloperProjects", fields: [developerId], references: [id], onDelete: Cascade)
  phases                ProjectPhase[]
  inventoryUnits        InventoryUnit[]
  paymentPlans          PaymentPlan[]
  brokerAccessRules     BrokerAccessRule[]
  clients               Client[]
  leads                 Lead[]
  leadClaims            LeadClaim[]
  leadClaimConflicts    LeadClaimConflict[]
  reservationRequests   ReservationRequest[]
  dealRooms             DealRoom[]
  deals                 Deal[]
  commissionRules       CommissionRule[]
  commissionEntries     CommissionEntry[]
  publicLeads           PublicLead[]
  crmLeads              CrmLead[]
  conversations         Conversation[]
  legalDocuments        LegalDocument[]
  cameraDevices         CameraDevice[]
  brokerAuthorizations  ProjectBrokerAuthorization[]
  visitorSessions       PublicVisitorSession[]
  visitorEvents         PublicVisitorEvent[]

  @@unique([developerId, slug])
  @@index([developerId, status])
  @@index([city, district])
  @@map("projects")
}

model OrganizationInvitation {
  id               String           @id @default(cuid())
  organizationId   String
  email            String
  intendedRole     UserRole
  tokenHash        String           @unique
  status           InvitationStatus @default(PENDING)
  expiresAt        DateTime
  acceptedAt       DateTime?
  createdByUserId  String
  acceptedByUserId String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  organization     Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy        User             @relation("InvitationCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  acceptedBy       User?            @relation("InvitationAcceptedBy", fields: [acceptedByUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, status])
  @@index([email, status])
  @@index([expiresAt, status])
  @@map("organization_invitations")
}

model ProjectBrokerAuthorization {
  id                 String                           @id @default(cuid())
  projectId          String
  organizationId     String?
  brokerUserId       String?
  status             ProjectBrokerAuthorizationStatus @default(ACTIVE)
  createdByUserId    String
  createdAt          DateTime                         @default(now())
  updatedAt          DateTime                         @updatedAt
  project            Project                          @relation(fields: [projectId], references: [id], onDelete: Cascade)
