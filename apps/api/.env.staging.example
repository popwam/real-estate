# API staging env placeholders. Do not commit real staging secrets.

NODE_ENV=production
PORT=3000

# Managed PostgreSQL connection string.
DATABASE_URL=postgresql://staging_user:replace-password@staging-postgres.example.com:5432/popwam_staging?schema=public

# JWT secrets must be unique, long, and stored in the deployment secret manager.
JWT_SECRET=replace-with-staging-access-secret
JWT_REFRESH_SECRET=replace-with-staging-refresh-secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Exact browser origins only. Do not use wildcards.
CORS_ORIGINS=https://admin-staging.popwam.com,https://staging.popwam.com

# Shared rate limits. Use Redis in staging to match multi-instance behavior.
RATE_LIMIT_BACKEND=redis
RATE_LIMIT_REDIS_URL=redis://:replace-password@staging-redis.example.com:6379

PUBLIC_LEAD_RATE_LIMIT_WINDOW_SECONDS=300
PUBLIC_CONVERSATION_MESSAGE_RATE_LIMIT_WINDOW_SECONDS=300
PUBLIC_CONVERSATION_MESSAGE_RATE_LIMIT_MAX=30
PUBLIC_LEAD_RATE_LIMIT_MAX=100
IN_RATE_LIMIT_WINDOW_SECONDS=300
AUTH_LOGIN_RATE_LIMIT_MAX=20
AUTH_REGISTER_RATE_LIMIT_WINDOW_SECONDS=300
AUTH_REGISTER_RATE_LIMIT_MAX=10
AUTH_REFRESH_RATE_LIMIT_WINDOW_SECONDS=300
AUTH_REFRESH_RATE_LIMIT_MAX=60

IMPORT_EXPORT_RATE_LIMIT_WINDOW_SECONDS=300
IMPORT_EXPORT_RATE_LIMIT_MAX=30
CRM_MUTATION_RATE_LIMIT_WINDOW_SECONDS=300
CRM_MUTATION_RATE_LIMIT_MAX=60
DOMAIN_MUTATION_RATE_LIMIT_WINDOW_SECONDS=300
DOMAIN_MUTATION_RATE_LIMIT_MAX=30
PUBLIC_LEAD_MANAGEMENT_RATE_LIMIT_WINDOW_SECONDS=300
PUBLIC_LEAD_MANAGEMENT_RATE_LIMIT_MAX=60

OPERATIONS_MUTATION_RATE_LIMIT_WINDOW_SECONDS=300
OPERATIONS_MUTATION_RATE_LIMIT_MAX=60
OPERATIONS_EXPORT_RATE_LIMIT_WINDOW_SECONDS=300
OPERATIONS_EXPORT_RATE_LIMIT_MAX=30
OPERATIONS_REPORT_RATE_LIMIT_WINDOW_SECONDS=300
OPERATIONS_REPORT_RATE_LIMIT_MAX=60

# Private attendance evidence storage. Store real values in the staging secret manager.
FILE_STORAGE_PROVIDER=s3
FILE_STORAGE_LOCAL_ROOT=
FILE_STORAGE_BUCKET=replace-with-private-staging-bucket
FILE_STORAGE_REGION=auto
FILE_STORAGE_ENDPOINT=https://replace-with-private-object-storage-endpoint
FILE_STORAGE_ACCESS_KEY_ID=replace-in-secret-manager
FILE_STORAGE_SECRET_ACCESS_KEY=replace-in-secret-manager
FILE_STORAGE_PUBLIC_BASE_URL=
ATTENDANCE_PHOTO_FRESHNESS_MINUTES=10
ATTENDANCE_EVIDENCE_RETENTION_DAYS=
ATTENDANCE_EVIDENCE_CLEANUP_ENABLED=false

# Optional observability placeholders.
OBSERVABILITY_PROVIDER=none
SENTRY_DSN=
DATADOG_API_KEY=
NEW_RELIC_LICENSE_KEY=
OTEL_EXPORTER_OTLP_ENDPOINT=
