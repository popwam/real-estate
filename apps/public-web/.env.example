# Public web origin used for canonical URLs, Open Graph URLs, sitemap, and robots.
NEXT_PUBLIC_SITE_URL=https://popwam.com

# Public API integration. Supported data modes:
# api: use backend public APIs
# mock: use existing mock adapters only
# hybrid: try API first, fallback to mock data
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000
NEXT_PUBLIC_PUBLIC_WEB_DATA_MODE=api

# Optional tracking placeholders. Leave empty to keep all tracking disabled.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_TIKTOK_PIXEL_ID=
