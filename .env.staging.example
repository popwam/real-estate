# POPWAM staging environment placeholders.
# Copy values into the deployment platform secret manager. Do not commit real secrets.

NODE_ENV=production

# Staging service URLs.
STAGING_API_URL=https://api-staging.popwam.com
STAGING_ADMIN_WEB_URL=https://admin-staging.popwam.com
STAGING_PUBLIC_WEB_URL=https://staging.popwam.com

# Staging smoke credentials. Use dedicated staging-only accounts.
STAGING_PLATFORM_EMAIL=platform-smoke@example.com
STAGING_PLATFORM_PASSWORD=replace-with-secret-manager-value
STAGING_DEVELOPER_EMAIL=developer-smoke@example.com
STAGING_DEVELOPER_PASSWORD=replace-with-secret-manager-value
STAGING_BROKERAGE_EMAIL=brokerage-smoke@example.com
STAGING_BROKERAGE_PASSWORD=replace-with-secret-manager-value
STAGING_BROKER_EMAIL=broker-smoke@example.com
STAGING_BROKER_PASSWORD=replace-with-secret-manager-value

# Optional staging smoke fixtures.
STAGING_PUBLIC_PROJECT_SLUG=known-public-project-slug
STAGING_CONVERSATION_TOKEN=known-public-conversation-token
